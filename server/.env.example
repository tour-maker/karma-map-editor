# Port the backend listens on (nginx proxies /api/ to this)
PORT=5051

# MongoDB connection string. Required — the server refuses to start without it.
# Use a database you own and control (MongoDB Atlas free tier is fine); never hardcode
# a fallback value in source code.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>?retryWrites=true&w=majority

# Secret used to sign admin/viewer JWTs — any long random string, keep it secret
JWT_SECRET=change-me-to-a-long-random-string

# Admin login credentials for the /admin panel
ADMIN_USER=admin
ADMIN_PASS=change-me

# Google Maps API key used server-side to render each shared plot's own
# satellite screenshot as the link-preview image (WhatsApp/Telegram/etc) —
# requires the "Maps Static API" to be enabled for this key in Google Cloud
# Console. Can reuse the same key as VITE_GOOGLE_MAPS_API_KEY (the frontend's
# key) if that key also has Maps Static API enabled, or use a separate one.
# Without this set, shared links fall back to the one generic preview image.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# --- Database choice -------------------------------------------------------
# STORAGE=sheets (default): the Google Sheet is the database, as before.
# STORAGE=mongo: MongoDB is the database; the Google Sheet becomes an automatic one-way copy
# (view / download as Excel). Run `node scripts/sheetToMongo.js` ONCE before switching.
STORAGE=sheets
# Set to "off" to stop copying to the Google Sheet (MongoDB only).
SHEETS_MIRROR=on
# Google Sheet id (the long id in the sheet URL)
GOOGLE_SHEET_ID=
# Google service-account credentials. On the VPS keep using server/service-account.json.
# On hosts without files (Render) paste the whole JSON here (or its base64).
GOOGLE_SERVICE_ACCOUNT_JSON=
